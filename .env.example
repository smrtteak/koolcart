# ---------- PayPal ----------
# Leave both empty to run in demo mode (PayPal responses simulated locally).
# https://developer.paypal.com/dashboard/applications/sandbox -> Create App
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ---------- AI (pick ONE; first match wins) ----------
# A) Nothing set -> local Ollama at http://localhost:11434 using the free cloud model gemma4:31b-cloud
#    (install Ollama, run `ollama signin` once). Zero cost.
# B) Google Gemini free tier (no card): https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# C) Claude
# ANTHROPIC_API_KEY=
# D) Any OpenAI-compatible server (Groq, OpenRouter, ollama.com, LM Studio...)
# AI_BASE_URL=https://ollama.com/v1
# AI_API_KEY=

# ---------- Hosting (optional; leave unset locally) ----------
# DATABASE_URL=             # Postgres connection string (e.g. free Neon). Unset: data lives in ./data/store.json
# SELLER_PASSCODE=          # passcode for the house account "Koolcart" (owns the starter shelf)
# DEMO_RESET_HOURS=         # wipe the shop back to the starter catalog every N hours (erases sellers' listings)

# Optional overrides
# AI_MODEL=                 # e.g. gemini-flash-latest, gemma4:31b-cloud, claude-opus-5-5
# OLLAMA_URL=http://localhost:11434/v1
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# DATA_FILE=./data/store.json
